PORT=3000
DATABASE_PATH=./data/verse-vs-verse.sqlite
WRITE_SECONDS=45
VOTE_SECONDS=30
ROUNDS_PER_SONG=4
RELEASE_SECONDS=20
MAX_SONGS_PER_HOUR=3
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
TWITCH_CHANNEL_LOGIN=
DEMO_ACTOR_LOGINS=demo_bot
DEMO_SCRIPT_PATH=./demo-scripts/demo.json

# OpenAI-compatible chat API (line judge and title)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
SCENE_MODEL=gpt-4.1

# Moderation: openai or none (local filters only)
MODERATION_PROVIDER=openai
OPENAI_API_KEY=

# Pascal routed audio models
PASCAL_API_KEY=
PASCAL_BASE_URL=https://api.pascalai.co/v1
PASCAL_MUSIC_MODEL=lyria-3-clip-preview
PASCAL_RELEASE_MODEL=lyria-3-pro-preview
PASCAL_TTS_MODEL=
PASCAL_ASR_MODEL=qwen3-asr-1.7b

# Local render tools (optional when available at default locations / PATH)
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
